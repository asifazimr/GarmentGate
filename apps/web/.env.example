# Copy to .env.local for local development: cp .env.example .env.local

# Server-only: where the NestJS API listens. The browser never calls it directly;
# Next.js proxies same-origin /api/* requests to it (see next.config.ts).
API_URL=http://localhost:4000

# Error monitoring (optional). Browser events use the NEXT_PUBLIC_ DSN; server events SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Build only (CI): upload source maps to Sentry. Without a token, nothing is uploaded.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

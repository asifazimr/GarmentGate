# Copy to .env.local for local development: cp .env.example .env.local
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets in them.

# Base URL of the GarmentGate API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this web app (used for absolute links, metadata, OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

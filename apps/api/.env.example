# Copy to .env for local development: cp .env.example .env
# Values below match docker-compose.yml at the repo root.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Serve Swagger UI at /docs and the OpenAPI JSON at /docs/json
SWAGGER_ENABLED=true

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

DATABASE_URL=postgresql://garmentgate:garmentgate@localhost:5432/garmentgate
REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=garmentgate-dev-master-key-change-me

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=garmentgate
S3_ACCESS_KEY_ID=garmentgate
S3_SECRET_ACCESS_KEY=garmentgate-dev-secret
S3_FORCE_PATH_STYLE=true

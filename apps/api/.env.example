# Copy to .env for local development: cp .env.example .env
# Values below match docker-compose.yml at the repo root.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# Serve Swagger UI at /docs and the OpenAPI JSON at /docs/json
SWAGGER_ENABLED=true
# Require a verified email before onboarding can be submitted. Set to false only for internal testing.
REQUIRE_EMAIL_VERIFICATION=true

# Global rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL_MS per client
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Public URL of the web app (used in email links)
WEB_APP_URL=http://localhost:3000
# Express "trust proxy": the web app forwards /api/* from localhost
TRUST_PROXY=loopback

# Auth. Generate a secret with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Must be true anywhere the app is served over HTTPS
COOKIE_SECURE=false

# Email via Resend (https://resend.com). Leave the key empty in development to log emails instead.
RESEND_API_KEY=
EMAIL_FROM=GarmentGate <onboarding@resend.dev>

# Printed on purchase orders
PLATFORM_LEGAL_NAME=GarmentGate Trading Ltd.
PLATFORM_ADDRESS=1 Sourcing Way, London EC2A 1AA, United Kingdom
PLATFORM_EMAIL=orders@garmentgate.example

PLATFORM_BANK_DETAILS=Bank: Example Bank plc|Account name: GarmentGate Trading Ltd.|IBAN: GB00 EXAM 0000 0000 0000 00|SWIFT/BIC: EXAMGB2L

# Card payments via Stripe (optional; leave empty to offer bank transfer / LC only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Texts (SMS / WhatsApp) through Twilio. Leave empty to log texts to the console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Public URL of /messaging/twilio/status (delivery receipts), e.g. https://api.garmentgate.com/messaging/twilio/status
TWILIO_STATUS_CALLBACK_URL=

DATABASE_URL=postgresql://garmentgate:garmentgate@localhost:5432/garmentgate
REDIS_URL=redis://localhost:6379

MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=garmentgate-dev-master-key-change-me
MEILISEARCH_INDEX_PREFIX=

# S3-compatible object storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=garmentgate
S3_ACCESS_KEY_ID=garmentgate
S3_SECRET_ACCESS_KEY=garmentgate-dev-secret
S3_FORCE_PATH_STYLE=true

# Malware scanning of uploads with ClamAV (clamd). Leave empty to skip scanning (development).
# In production run clamd next to the API and set StreamMaxLength to at least 64M (largest upload: 50 MB).
CLAMAV_HOST=
CLAMAV_PORT=3310

# Error monitoring (optional). Events are scrubbed of cookies, headers, bodies and identities.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

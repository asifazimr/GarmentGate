enum ShipmentDocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  AIRWAY_BILL
  CERTIFICATE_OF_ORIGIN
  INSPECTION_CERTIFICATE
  OTHER
}

enum ReviewStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN

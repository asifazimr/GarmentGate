// GarmentGate data model.
//
// Rules encoded here (see CLAUDE.md):
// - Company holds real identities and is admin-only. Buyers and manufacturers only ever see
//   each other's public codes (BuyerProfile.publicCode / ManufacturerProfile.publicCode).
// - Every price that exists on both sides is stored twice: buyer*Minor (what the buyer pays us)
//   and manufacturer*Minor (what we pay the manufacturer). Margin is derived, never stored.
// - Money is integer minor units + Currency. Unit prices are Int; totals and ledger amounts BigInt.
// - User-generated text keeps the original (admin-only) next to the contact-filtered version.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  MANUFACTURER
  ADMIN
  /// GarmentGate's QC inspectors: staff-side, no company.
  INSPECTOR
  /// Staff of a logistics partner: sees only GarmentGate's bookings for that partner.
  PARTNER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyRole {
  OWNER
  MEMBER
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CompanyType {
  BUYER
  MANUFACTURER
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// Where a company left the onboarding wizard, so it can resume later.
enum OnboardingStep {
  COMPANY_INFO
  PROFILE
  DOCUMENTS
  SUBMITTED
}

enum BuyerBusinessType {
  BRAND
  RETAILER
  IMPORTER
  WHOLESALER
  SOURCING_AGENT
  OTHER
}

enum CompanyDocumentType {
  BUSINESS_LICENSE
  EXPORT_REGISTRATION
  TAX_CERTIFICATE
  BANK_LETTER
  ID_PROOF
  OTHER
}

enum ReviewState {
  PENDING
  VERIFIED
  REJECTED
}

enum CertificationType {
  BSCI_AMFORI
  WRAP
  SEDEX_SMETA
  OEKO_TEX_100
  GOTS
  GRS
  BCI
  ISO_9001
  ISO_14001
  SA8000
  FAIR_TRADE
  HIGG_FEM
  OTHER
}

enum CertificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Currency {
  USD
  EUR
  GBP
  BDT
  INR
  VND
  TRY
  PKR
  CNY
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum RfqInvitationStatus {
  INVITED
  VIEWED
  DECLINED
  QUOTED
}

enum RfqAttachmentKind {
  TECH_PACK
  REFERENCE_IMAGE
  SIZE_CHART
  OTHER
}

/// SUBMITTED (by manufacturer) → UNDER_REVIEW (buyer price pre-filled by MarginRule)
/// → OFFERED (released to buyer by an admin) → ACCEPTED | REJECTED.
enum QuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// Threads are always between one side and GarmentGate, never buyer↔manufacturer.
enum ConversationType {
  BUYER_PLATFORM
  MANUFACTURER_PLATFORM
  SUPPORT
}

enum ContactFlag {
  EMAIL
  PHONE
  URL
  SOCIAL_HANDLE
  OBFUSCATED_CONTACT
  OTHER
}

enum ModerationStatus {
  CLEAN
  FLAGGED
  REVIEWED_OK
  REVIEWED_BLOCKED
}

enum OrderStatus {
  /// Created when the buyer accepts a quote; terms are confirmed before any deposit.
  DRAFT
  SAMPLING
  SAMPLE_APPROVED
  DEPOSIT_PENDING
  IN_PRODUCTION
  QC
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStage {
  ORDER_CONFIRMED
  FABRIC_SOURCING
  CUTTING
  SEWING
  FINISHING
  PACKING
  READY_FOR_INSPECTION
  SHIPPED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum SampleType {
  /// A sample of an existing catalog style, requested from the product page.
  CATALOG
  PROTO
  FIT
  SIZE_SET
  PRE_PRODUCTION
  TOP
  SHIPMENT
}

enum SampleStatus {
  REQUESTED
  IN_PROGRESS
  SHIPPED
  RECEIVED
  APPROVED
  REJECTED
}

enum PaymentDirection {
  INBOUND
  OUTBOUND
}

enum PaymentPurpose {
  DEPOSIT
  BALANCE
  SAMPLE_FEE
  PAYOUT
  REFUND
  /// Freight, insurance and (DDP) duties GarmentGate charges for shipping an order.
  LOGISTICS
  /// Money an insurer paid GarmentGate on a logistics claim.
  INSURANCE_RECOVERY
  /// The buyer's inspection-day fees (QC).
  INSPECTION_FEE
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  LETTER_OF_CREDIT
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum LedgerAccountType {
  PLATFORM_CASH
  BUYER_ESCROW
  MANUFACTURER_PAYABLE
  PLATFORM_REVENUE
  /// What GarmentGate owes a logistics partner (per partner).
  PARTNER_PAYABLE
  /// What GarmentGate owes its gig QC inspectors (per inspector: see inspections).
  INSPECTOR_PAYABLE
}

enum LedgerTransactionKind {
  DEPOSIT
  HOLD
  RELEASE
  REFUND
  COMMISSION
  PAYOUT
  /// Logistics claims: compensation, insurer recovery, partner chargeback.
  CLAIM
  /// Factory plan subscriptions (cash → revenue).
  SUBSCRIPTION
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum InspectionType {
  PRE_PRODUCTION
  DURING_PRODUCTION
  PRE_SHIPMENT
  CONTAINER_LOADING
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
  ON_HOLD
}

enum ReviewStatus {
  PENDING_MODERATION
  PUBLISHED
  HIDDEN
}

enum DisputeReason {
  QUALITY
  QUANTITY
  LATE_DELIVERY
  NOT_AS_DESCRIBED
  PAYMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_FOR_BUYER
  RESOLVED_FOR_MANUFACTURER
  SETTLED
  CLOSED
}

enum NotificationType {
  EMAIL_VERIFIED
  KYC_SUBMITTED
  KYC_APPROVED
  KYC_REJECTED
  RFQ_INVITATION
  QUOTE_RECEIVED
  QUOTE_OFFERED
  ORDER_UPDATE
  MILESTONE_UPDATE
  QC_RESULT
  MESSAGE_RECEIVED
  PAYMENT_UPDATE
  DISPUTE_UPDATE
  REVIEW_RECEIVED
  SYSTEM
}

enum NotificationCategory {
  QUOTES
  MESSAGES
  ORDERS
  QC
  PAYMENTS
  DISPUTES
  REVIEWS
  ACCOUNT
}

enum ReviewDirection {
  BUYER_TO_MANUFACTURER
  MANUFACTURER_TO_BUYER
}

enum DisputeParty {
  BUYER
  MANUFACTURER
  STAFF
}

enum FilePurpose {
  KYC_DOCUMENT
  CERTIFICATION
  PRODUCT_IMAGE
  FACTORY_PHOTO
  TECH_PACK
  MESSAGE_ATTACHMENT
  MILESTONE_PHOTO
  SAMPLE_PHOTO
  PAYMENT_PROOF
  INSPECTION_REPORT
  /// Legacy: papers of the retired factory-booked shipments (now logistics uploads).
  SHIPMENT_DOCUMENT
  INSPECTION_PHOTO
  HUB_PHOTO
  LOGISTICS_DOCUMENT
  DISPUTE_EVIDENCE
  SUPPLIER_CLAIM_EVIDENCE
  AVATAR
  OTHER
}

enum ImageProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Human review of images shown to buyers (logos, signage, faces).
enum MediaReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FileStatus {
  PENDING_UPLOAD
  UPLOADED
  REJECTED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 String       @id @default(uuid(7)) @db.Uuid
  /// Always stored lowercased and trimmed.
  email              String       @unique
  passwordHash       String
  role               Role
  /// PARTNER users: the logistics partner they work for.
  logisticsPartnerId String?      @db.Uuid
  status             UserStatus   @default(ACTIVE)
  locale             String       @default("en")
  /// Verified mobile number for texts (E.164). Never shown to the other side.
  phoneE164          String?
  phoneVerifiedAt    DateTime?
  /// A number waiting for its code (moves to phoneE164 once confirmed).
  pendingPhone       String?
  phoneCodeHash      String?
  phoneCodeExpiresAt DateTime?
  phoneCodeAttempts  Int          @default(0)
  textChannel        TextChannel  @default(SMS)
  /// Show amounts converted to this currency too (null: only the transaction's own currency).
  displayCurrency    Currency?
  firstName          String
  lastName           String
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  /// Why staff suspended the account (shown to staff only).
  suspendedReason    String?
  suspendedAt        DateTime?
  companyId          String?      @db.Uuid
  companyRole        CompanyRole?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  sessions                    Session[]
  tokens                      UserToken[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  uploadedFiles               FileAsset[]
  conversationsJoined         ConversationParticipant[]
  messagesSent                Message[]
  rfqsCreated                 Rfq[]
  capacityBookingsCreated     CapacityBooking[]         @relation("CapacityBookingCreatedBy")
  logisticsPartner            LogisticsPartner?         @relation(fields: [logisticsPartnerId], references: [id], onDelete: SetNull)
  capacityPartnershipsCreated CapacityPartnership[]     @relation("CapacityPartnershipCreatedBy")
  quotesPriced                Quote[]                   @relation("QuotePricedBy")
  kycReviews                  Company[]                 @relation("KycReviewedBy")
  disputesOpened              Dispute[]                 @relation("DisputeOpenedBy")
  disputesResolved            Dispute[]                 @relation("DisputeResolvedBy")
  disputeEvidence             DisputeEvidence[]
  notificationPrefs           NotificationPreference[]
  disputesAssigned            Dispute[]                 @relation("DisputeAssignedTo")
  accountWarnings             AccountWarning[]          @relation("UserWarnings")
  warningsIssued              AccountWarning[]          @relation("WarningIssuedBy")
  supplierClaimsReviewed      SupplierClaim[]           @relation("SupplierClaimReviewedBy")
  orderEvents                 OrderEvent[]
  paymentsConfirmed           Payment[]                 @relation("PaymentConfirmedBy")
  releasesApproved            OrderRelease[]            @relation("ReleaseApprovedBy")
  inspectionsBooked           Inspection[]              @relation("InspectionBookedBy")
  inspectionsAssigned         Inspection[]              @relation("InspectionInspector")

  @@index([companyId])
  @@index([role, status])
  outboundMessages OutboundMessage[]
  @@map("users")
}

/// One row per refresh token. Rotation replaces the row; reuse of a revoked token
/// outside the grace window revokes the whole family.
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  familyId         String    @db.Uuid
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?   @db.Uuid
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @db.Uuid
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Atomic counters for human-readable codes (MFR-BD-0421, RFQ-2026-00042, …).
model CodeSequence {
  prefix    String @id
  lastValue Int    @default(0)

  @@map("code_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Companies, profiles, KYC
// ─────────────────────────────────────────────────────────────────────────────

/// Real legal identity. ADMIN-ONLY: never serialize to the other side of a deal.
model Company {
  id                 String         @id @default(uuid(7)) @db.Uuid
  type               CompanyType
  legalName          String
  tradeName          String?
  /// ISO 3166-1 alpha-2
  country            String         @db.Char(2)
  city               String?
  addressLine1       String?
  addressLine2       String?
  postalCode         String?
  registrationNumber String?
  taxId              String?
  website            String?
  /// Buyers: the GarmentGate staff member who looks after this account (single point of contact).
  merchandiserId     String?        @db.Uuid
  phone              String?
  yearEstablished    Int?
  onboardingStep     OnboardingStep @default(PROFILE)
  kycStatus          KycStatus      @default(NOT_SUBMITTED)
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycReviewedById    String?        @db.Uuid
  kycRejectionReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  kycReviewedBy User? @relation("KycReviewedBy", fields: [kycReviewedById], references: [id], onDelete: SetNull)

  users                User[]
  documents            CompanyDocument[]
  buyerProfile         BuyerProfile?
  manufacturerProfile  ManufacturerProfile?
  files                FileAsset[]
  rfqs                 Rfq[]
  ordersAsBuyer        Order[]
  capacityBookings     CapacityBooking[]
  capacityPartnerships CapacityPartnership[]
  consolidations       Consolidation[]
  logisticsShipments   LogisticsShipment[]
  marginRules          MarginRule[]
  ledgerAccounts       LedgerAccount[]
  conversations        Conversation[]
  reviewsWritten       Review[]
  reviewsReceived      Review[]              @relation("ReviewSubject")
  shortlists           Shortlist[]

  @@index([type, kycStatus])
  @@index([kycStatus, kycSubmittedAt])
  @@index([country])
  planSubscriptions PlanSubscription[]
  @@map("companies")
}

model CompanyDocument {
  id              String              @id @default(uuid(7)) @db.Uuid
  companyId       String              @db.Uuid
  type            CompanyDocumentType
  fileId          String              @unique @db.Uuid
  status          ReviewState         @default(PENDING)
  documentNumber  String?
  expiresAt       DateTime?
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file    FileAsset @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([companyId, type])
  @@index([status])
  @@map("company_documents")
}

model BuyerProfile {
  id                      String             @id @default(uuid(7)) @db.Uuid
  companyId               String             @unique @db.Uuid
  /// e.g. BYR-US-0012 — what manufacturers and admins-in-relay see.
  publicCode              String             @unique
  /// GarmentGate Plus in force (kept in step with its subscriptions by BuyerPlusService).
  plusActive              Boolean            @default(false)
  businessType            BuyerBusinessType?
  annualVolumePcs         Int?
  typicalOrderQuantityPcs Int?
  /// ISO 3166-1 alpha-2 codes of markets the buyer sells into.
  targetMarkets           String[]
  sourcingNeeds           String?
  sourcingNeedsFiltered   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories Category[] @relation("BuyerCategories")

  @@map("buyer_profiles")
}

/// Buyer-facing manufacturer record. Only publicCode identifies the factory to buyers.
model ManufacturerProfile {
  id                        String   @id @default(uuid(7)) @db.Uuid
  companyId                 String   @unique @db.Uuid
  /// e.g. MFR-BD-0421
  publicCode                String   @unique
  /// Where the factory is (staff-entered): inspectors' task distance and GPS check-in.
  latitude                  Decimal? @db.Decimal(9, 6)
  longitude                 Decimal? @db.Decimal(9, 6)
  /// The plan in force (kept in step with its subscriptions by PlansService).
  planTier                  PlanTier @default(FREE)
  /// Denormalised from the plan for the search index.
  searchBoost               Int      @default(0)
  headline                  String?
  about                     String?
  aboutFiltered             String?
  monthlyCapacityPcs        Int?
  moqPcs                    Int?
  sampleLeadTimeDays        Int?
  productionLeadTimeMinDays Int?
  productionLeadTimeMaxDays Int?
  /// [{ "type": "Single needle lockstitch", "count": 120 }, …]
  machinery                 Json?
  workforceSize             Int?
  factorySizeSqm            Int?
  /// ISO 3166-1 alpha-2 codes
  exportMarkets             String[]
  /// 0–100, recalculated from orders, inspections and reviews.
  performanceScore          Int      @default(0)
  /// Basis points (9450 = 94.5%).
  onTimeDeliveryBps         Int?
  /// Final inspections passed first time, basis points.
  qcPassBps                 Int?
  /// Published buyer reviews and their averages ×100 (462 = 4.62), kept by the trust service.
  reviewCount               Int      @default(0)
  ratingAvgX100             Int?
  qualityAvgX100            Int?
  communicationAvgX100      Int?
  onTimeAvgX100             Int?
  isListed                  Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categories           Category[]            @relation("ManufacturerCategories")
  certifications       Certification[]
  products             Product[]
  rfqInvitations       RfqInvitation[]
  photos               FactoryPhoto[]
  capacityMonths       CapacityMonth[]
  shortlistItems       ShortlistItem[]
  quotes               Quote[]
  orders               Order[]
  reviewsReceived      Review[]
  productionLines      ProductionLine[]
  capacityBookings     CapacityBooking[]
  capacityPartnerships CapacityPartnership[]
  supplierClaims       SupplierClaim[]

  @@index([isListed, performanceScore])
  subscriptions PlanSubscription[]

  @@map("manufacturer_profiles")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  parentId  String?  @db.Uuid
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  manufacturers        ManufacturerProfile[] @relation("ManufacturerCategories")
  buyers               BuyerProfile[]        @relation("BuyerCategories")
  products             Product[]
  rfqs                 Rfq[]
  marginRules          MarginRule[]
  productionLines      ProductionLine[]      @relation("ProductionLineCategories")
  capacityBookings     CapacityBooking[]
  capacityPartnerships CapacityPartnership[]

  @@index([parentId])
  @@map("categories")
}

model Certification {
  id                    String              @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String              @db.Uuid
  type                  CertificationType
  /// For OTHER, the certificate's name.
  customName            String?
  /// Identifies the factory: admin-only.
  certificateNumber     String?
  issuedAt              DateTime?
  expiresAt             DateTime?
  fileId                String?             @unique @db.Uuid
  status                CertificationStatus @default(PENDING)
  verifiedAt            DateTime?
  rejectionReason       String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  file                FileAsset?          @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([manufacturerProfileId, type])
  @@index([status, expiresAt])
  @@map("certifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id                    String        @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String        @db.Uuid
  categoryId            String        @db.Uuid
  title                 String
  description           String?
  descriptionFiltered   String?
  fabric                String?
  composition           String?
  gsm                   Int?
  moqPcs                Int
  leadTimeDays          Int
  currency              Currency      @default(USD)
  status                ProductStatus @default(DRAFT)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceTiers          ProductPriceTier[]
  images              ProductImage[]
  rfqs                Rfq[]
  shortlistItems      ShortlistItem[]

  @@index([manufacturerProfileId, status])
  @@index([categoryId, status])
  @@map("products")
}

/// Price for orders of at least minQty pieces. Both sides' prices live together.
model ProductPriceTier {
  id                         String @id @default(uuid(7)) @db.Uuid
  productId                  String @db.Uuid
  minQty                     Int
  manufacturerUnitPriceMinor Int
  buyerUnitPriceMinor        Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@map("product_price_tiers")
}

model ProductImage {
  id           String            @id @default(uuid(7)) @db.Uuid
  productId    String            @db.Uuid
  fileId       String            @unique @db.Uuid
  sortOrder    Int               @default(0)
  alt          String?
  /// Buyers only see APPROVED images, and only their processed renditions.
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?

  product Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Photos of the factory floor for the buyer-facing profile.
model FactoryPhoto {
  id                    String            @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String            @db.Uuid
  fileId                String            @unique @db.Uuid
  caption               String?
  sortOrder             Int               @default(0)
  reviewStatus          MediaReviewStatus @default(PENDING)
  reviewNote            String?
  reviewedAt            DateTime?
  createdAt             DateTime          @default(now())

  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  file                FileAsset           @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([manufacturerProfileId, sortOrder])
  @@index([reviewStatus])
  @@map("factory_photos")
}

/// Per-month capacity plan. Rows exist only for months the factory adjusted.
model CapacityMonth {
  id                    String   @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String   @db.Uuid
  /// First day of the month (UTC).
  month                 DateTime @db.Date
  /// Override of ManufacturerProfile.monthlyCapacityPcs for this month.
  availablePcs          Int?
  /// Capacity already sold outside GarmentGate.
  externalBookedPcs     Int      @default(0)
  note                  String?
  updatedAt             DateTime @updatedAt

  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)

  @@unique([manufacturerProfileId, month])
  @@map("capacity_months")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sourcing: RFQs, quotes, margin rules
// ─────────────────────────────────────────────────────────────────────────────

model Rfq {
  id                   String    @id @default(uuid(7)) @db.Uuid
  /// e.g. RFQ-2026-00042
  code                 String    @unique
  buyerCompanyId       String    @db.Uuid
  createdById          String    @db.Uuid
  categoryId           String    @db.Uuid
  title                String
  /// Contact-filtered title: what factories see.
  titleFiltered        String?
  description          String
  descriptionFiltered  String
  quantity             Int
  targetUnitPriceMinor Int?
  currency             Currency  @default(USD)
  /// Quotes are due by this date.
  deadline             DateTime
  requiredDeliveryDate DateTime?
  incoterm             Incoterm?
  /// ISO 3166-1 alpha-2
  destinationCountry   String?   @db.Char(2)
  /// Set when the request started from a catalog product.
  productId            String?   @db.Uuid
  /// Full-package conversion of a capacity booking: invite-only to the booked factory.
  capacityBookingId    String?   @unique @db.Uuid
  status               RfqStatus @default(DRAFT)
  publishedAt          DateTime?
  /// Until then only factories with a plan head start see it (null: no head-start factory matched).
  headStartEndsAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  buyerCompany    Company          @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  capacityBooking CapacityBooking? @relation("CapacityBookingRfq", fields: [capacityBookingId], references: [id], onDelete: SetNull)
  invitations     RfqInvitation[]
  attachments     RfqAttachment[]
  quotes          Quote[]
  orders          Order[]
  samples         Sample[]
  conversations   Conversation[]

  @@index([buyerCompanyId, status])
  @@index([status, deadline])
  @@index([categoryId])
  /// Admin overview: RFQ → order conversion by publication month.
  @@index([publishedAt])
  @@map("rfqs")
}

/// Admins route each RFQ to selected manufacturers.
model RfqInvitation {
  id                    String              @id @default(uuid(7)) @db.Uuid
  rfqId                 String              @db.Uuid
  manufacturerProfileId String              @db.Uuid
  status                RfqInvitationStatus @default(INVITED)
  invitedAt             DateTime            @default(now())
  /// Open RFQs reach factories without a plan head start later (and are announced then).
  visibleAt             DateTime            @default(now())
  notifiedAt            DateTime?
  respondedAt           DateTime?
  declineReason         String?

  rfq                 Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)

  @@unique([rfqId, manufacturerProfileId])
  @@index([manufacturerProfileId, status])
  @@index([notifiedAt, visibleAt])
  @@map("rfq_invitations")
}

model RfqAttachment {
  id           String            @id @default(uuid(7)) @db.Uuid
  rfqId        String            @db.Uuid
  fileId       String            @unique @db.Uuid
  kind         RfqAttachmentKind
  /// Factories only get a file once it is sanitized AND an admin approved it (logos, labels).
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  rfq  Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([rfqId])
  @@map("rfq_attachments")
}

model Quote {
  id                         String      @id @default(uuid(7)) @db.Uuid
  rfqId                      String      @db.Uuid
  manufacturerProfileId      String      @db.Uuid
  manufacturerUnitPriceMinor Int
  /// Pre-filled from the matching MarginRule, adjustable by an admin. Null until priced.
  buyerUnitPriceMinor        Int?
  currency                   Currency
  leadTimeDays               Int
  moqPcs                     Int?
  validUntil                 DateTime?
  notes                      String?
  notesFiltered              String?
  status                     QuoteStatus @default(SUBMITTED)
  marginRuleId               String?     @db.Uuid
  pricedById                 String?     @db.Uuid
  pricedAt                   DateTime?
  offeredAt                  DateTime?
  decidedAt                  DateTime?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  rfq                 Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)
  marginRule          MarginRule?         @relation(fields: [marginRuleId], references: [id], onDelete: SetNull)
  pricedBy            User?               @relation("QuotePricedBy", fields: [pricedById], references: [id], onDelete: SetNull)
  order               Order?

  @@unique([rfqId, manufacturerProfileId])
  @@index([rfqId, status])
  @@index([manufacturerProfileId, status])
  @@index([status, createdAt])
  @@map("quotes")
}

/// Markup applied to manufacturer prices. Most specific active rule wins:
/// company + category > company > category > default (both null).
model MarginRule {
  id                    String   @id @default(uuid(7)) @db.Uuid
  name                  String
  /// Basis points over the manufacturer price (1500 = 15%).
  markupBps             Int
  /// Optional floor per unit, in the quote's currency minor units.
  minMarginPerUnitMinor Int?
  /// Commission withheld from the factory's payouts, basis points of the factory total.
  commissionBps         Int      @default(0)
  /// Lower commission when the buyer has ordered from that factory before (null: same rate).
  repeatCommissionBps   Int?
  categoryId            String?  @db.Uuid
  /// Usually a buyer company with negotiated rates.
  companyId             String?  @db.Uuid
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company  Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes   Quote[]

  @@index([active, companyId, categoryId])
  @@map("margin_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messaging (relayed: each thread is one side ↔ GarmentGate)
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id            String           @id @default(uuid(7)) @db.Uuid
  type          ConversationType
  /// The external party: a buyer company for BUYER_PLATFORM, a manufacturer company for
  /// MANUFACTURER_PLATFORM. A thread never has members from two external companies.
  companyId     String           @db.Uuid
  subject       String
  rfqId         String?          @db.Uuid
  orderId       String?          @db.Uuid
  disputeId     String?          @db.Uuid
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company      Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rfq          Rfq?                      @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  order        Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dispute      Dispute?                  @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([companyId, lastMessageAt])
  @@index([rfqId])
  @@index([orderId])
  @@index([disputeId])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id               String           @id @default(uuid(7)) @db.Uuid
  conversationId   String           @db.Uuid
  senderId         String           @db.Uuid
  /// Exactly what the sender typed. ADMIN-ONLY.
  originalContent  String
  /// What other participants receive.
  filteredContent  String
  /// Set when an admin relayed this message from the other side's thread.
  relayedFromId    String?          @db.Uuid
  flagged          Boolean          @default(false)
  flagReasons      ContactFlag[]
  moderationStatus ModerationStatus @default(CLEAN)
  editedAt         DateTime?
  createdAt        DateTime         @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([flagged, moderationStatus])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id          String        @id @default(uuid(7)) @db.Uuid
  messageId   String        @db.Uuid
  fileId      String        @unique @db.Uuid
  /// Contact-filtered file name: what other participants see.
  displayName String
  /// Contact details found in the file name or the PDF's text.
  flagged     Boolean       @default(false)
  flagReasons ContactFlag[]
  /// When the PDF text was checked (null: not checked yet, or not a PDF).
  scannedAt   DateTime?

  message Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id                         String       @id @default(uuid(7)) @db.Uuid
  /// e.g. ORD-2026-00017
  code                       String       @unique
  buyerCompanyId             String       @db.Uuid
  manufacturerProfileId      String       @db.Uuid
  rfqId                      String?      @db.Uuid
  quoteId                    String?      @unique @db.Uuid
  /// Harmonized System code (6–10 digits) for documents and duty estimates; set by staff.
  hsCode                     String?
  title                      String
  specification              String?
  quantity                   Int
  /// What the buyer pays GarmentGate per unit. Buyer-facing.
  buyerUnitPriceMinor        Int
  /// What GarmentGate pays the manufacturer per unit. Manufacturer-facing.
  manufacturerUnitPriceMinor Int
  buyerTotalMinor            BigInt
  manufacturerTotalMinor     BigInt
  currency                   Currency
  incoterm                   Incoterm
  /// ISO 3166-1 alpha-2
  destinationCountry         String       @db.Char(2)
  destinationPort            String?
  /// Basis points of buyerTotal due as deposit (3000 = 30%).
  depositBps                 Int          @default(3000)
  requestedShipDate          DateTime?
  status                     OrderStatus  @default(DRAFT)
  /// Where the order stood when it was disputed.
  disputedFrom               OrderStatus?
  /// Set when the buyer reordered a completed order.
  reorderOfId                String?      @db.Uuid
  /// Commission withheld from the factory, snapshotted when the order is confirmed.
  commissionBps              Int          @default(0)
  commissionMinor            BigInt       @default(0)
  /// The buyer had completed an order with this factory before (reduced commission).
  repeatOrder                Boolean      @default(false)
  confirmedAt                DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  buyerCompany        Company                  @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  manufacturerProfile ManufacturerProfile      @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)
  rfq                 Rfq?                     @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  capacityBooking     CapacityBooking?
  logisticsQuotes     LogisticsQuote[]
  packing             OrderPacking?
  pickups             PickupRequest[]
  hubReceipts         HubReceipt[]
  logisticsShipments  LogisticsShipmentOrder[]
  quote               Quote?                   @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  milestones         OrderMilestone[]
  samples            Sample[]
  payments           Payment[]
  ledgerTransactions LedgerTransaction[]
  inspections        Inspection[]
  reviews            Review[]
  disputes           Dispute[]
  charges            OrderCharge[]
  /// Sample fees credited against the balance when the bulk deposit arrived (GarmentGate-funded).
  sampleCreditMinor  BigInt               @default(0)
  /// A call-off placed under a supply contract.
  contractId         String?              @db.Uuid
  contract           SupplyContract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Last time staff, factory and buyer were alerted that the order runs late (one alert a week).
  delayAlertedAt     DateTime?
  factoryChanges     OrderFactoryChange[]
  logisticsClaims    LogisticsClaim[]
  conversations      Conversation[]
  releases           OrderRelease[]
  events             OrderEvent[]
  reorderOf          Order?               @relation("Reorders", fields: [reorderOfId], references: [id], onDelete: SetNull)
  reorders           Order[]              @relation("Reorders")

  @@index([buyerCompanyId, status])
  @@index([manufacturerProfileId, status])
  @@index([status, createdAt])
  /// Repeat-order commission: has this buyer completed an order with this factory?
  @@index([buyerCompanyId, manufacturerProfileId, status])
  /// Admin overview: GMV by confirmation month.
  @@index([confirmedAt])
  @@map("orders")
}

/// Colour × size breakdown of the order quantity.
model OrderItem {
  id       String  @id @default(uuid(7)) @db.Uuid
  orderId  String  @db.Uuid
  color    String
  size     String
  quantity Int
  sku      String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, color, size])
  @@map("order_items")
}

model OrderMilestone {
  id           String          @id @default(uuid(7)) @db.Uuid
  orderId      String          @db.Uuid
  stage        MilestoneStage
  status       MilestoneStatus @default(PENDING)
  plannedAt    DateTime?
  completedAt  DateTime?
  note         String?
  noteFiltered String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos MilestonePhoto[]

  @@unique([orderId, stage])
  @@map("order_milestones")
}

model MilestonePhoto {
  id           String            @id @default(uuid(7)) @db.Uuid
  milestoneId  String            @db.Uuid
  fileId       String            @unique @db.Uuid
  takenAt      DateTime?
  caption      String?
  /// Buyers see factory photos/videos only once sanitized AND approved (logos, signage, faces).
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  milestone OrderMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  file      FileAsset      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_photos")
}

model Sample {
  id                    String       @id @default(uuid(7)) @db.Uuid
  /// 1 for the first sample of an order, +1 for each revision.
  round                 Int          @default(1)
  requestNotes          String?
  requestNotesFiltered  String?
  /// A sample belongs to an RFQ (pre-order) or an order.
  rfqId                 String?      @db.Uuid
  orderId               String?      @db.Uuid
  type                  SampleType
  status                SampleStatus @default(REQUESTED)
  quantity              Int          @default(1)
  buyerFeeMinor         Int?
  currency              Currency?
  courier               String?
  trackingNumber        String?
  shippedAt             DateTime?
  receivedAt            DateTime?
  buyerFeedback         String?
  buyerFeedbackFiltered String?
  decidedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  rfq    Rfq?          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  order  Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photos SamplePhoto[]

  @@index([orderId, type])
  @@index([rfqId])
  @@map("samples")
}

// ─────────────────────────────────────────────────────────────────────────────
// Money: payments and double-entry escrow ledger
// ─────────────────────────────────────────────────────────────────────────────

model Payment {
  id                    String           @id @default(uuid(7)) @db.Uuid
  /// Order payments. Booking deposits have capacityBookingId instead (both once the booking became an order).
  orderId               String?          @db.Uuid
  capacityBookingId     String?          @db.Uuid
  /// Logistics partner payouts are tied to the shipment they pay for.
  logisticsShipmentId   String?          @db.Uuid
  /// Human reference the payer quotes, e.g. PAY-ORD-2026-00017-D1.
  reference             String?          @unique
  /// What the payer says they used (their bank reference); unverified.
  payerReference        String?
  /// Admin-only proof of receipt (bank statement, SWIFT copy, LC).
  proofFileId           String?          @unique @db.Uuid
  confirmedById         String?          @db.Uuid
  /// Units of `currency` per USD at the time the money moved.
  unitsPerUsd           Decimal?         @db.Decimal(20, 10)
  amountUsdMinor        BigInt?
  /// Payouts in another currency: what was actually sent.
  settlementCurrency    Currency?
  settlementAmountMinor BigInt?
  releaseId             String?          @unique @db.Uuid
  /// Payouts: the verified factory bank account the transfer went to.
  factoryBankAccountId  String?          @db.Uuid
  direction             PaymentDirection
  purpose               PaymentPurpose
  amountMinor           BigInt
  currency              Currency
  method                PaymentMethod
  provider              String?
  providerRef           String?          @unique
  status                PaymentStatus    @default(PENDING)
  paidAt                DateTime?
  failureReason         String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  order             Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capacityBooking   CapacityBooking?    @relation(fields: [capacityBookingId], references: [id], onDelete: Restrict)
  logisticsShipment LogisticsShipment?  @relation(fields: [logisticsShipmentId], references: [id], onDelete: Restrict)
  transactions      LedgerTransaction[]
  proofFile         FileAsset?          @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  confirmedBy       User?               @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  release           OrderRelease?       @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@index([orderId, status])
  @@index([capacityBookingId, status])
  @@index([status, createdAt])
  @@map("payments")
}

/// One account per (type, company, currency). Platform accounts have no company.
model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  type      LedgerAccountType
  companyId String?           @db.Uuid
  currency  Currency
  createdAt DateTime          @default(now())

  logisticsPartnerId String? @db.Uuid

  company          Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  logisticsPartner LogisticsPartner?   @relation(fields: [logisticsPartnerId], references: [id], onDelete: Restrict)
  entries          EscrowLedgerEntry[]

  @@unique([type, companyId, currency])
  @@map("ledger_accounts")
}

/// A balanced group of entries: sum(DEBIT) == sum(CREDIT), single currency.
model LedgerTransaction {
  id                String                @id @default(uuid(7)) @db.Uuid
  kind              LedgerTransactionKind
  orderId           String?               @db.Uuid
  capacityBookingId String?               @db.Uuid
  paymentId         String?               @db.Uuid
  currency          Currency
  description       String
  idempotencyKey    String                @unique
  postedAt          DateTime              @default(now())
  /// Units of `currency` per USD when posted, and the USD value: for multi-currency reporting.
  unitsPerUsd       Decimal               @default(1) @db.Decimal(20, 10)
  amountUsdMinor    BigInt                @default(0)

  order           Order?              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capacityBooking CapacityBooking?    @relation(fields: [capacityBookingId], references: [id], onDelete: Restrict)
  payment         Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  entries         EscrowLedgerEntry[]

  @@index([orderId, postedAt])
  @@index([capacityBookingId, postedAt])
  @@map("ledger_transactions")
}

/// Append-only. amountMinor is always positive; direction gives the sign.
model EscrowLedgerEntry {
  id            String         @id @default(uuid(7)) @db.Uuid
  transactionId String         @db.Uuid
  accountId     String         @db.Uuid
  direction     EntryDirection
  amountMinor   BigInt
  createdAt     DateTime       @default(now())

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transactionId])
  @@map("escrow_ledger_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quality and logistics
// ─────────────────────────────────────────────────────────────────────────────

model Inspection {
  id               String           @id @default(uuid(7)) @db.Uuid
  orderId          String           @db.Uuid
  type             InspectionType
  agency           String?
  scheduledAt      DateTime?
  inspectedAt      DateTime?
  /// Who booked it (a buyer member or staff); null when the platform opened it on entering QC.
  bookedById       String?          @db.Uuid
  inspectorId      String?          @db.Uuid
  /// When an inspector was first assigned (the KPI "inspector assignment time").
  assignedAt       DateTime?
  /// The inspector was at the factory (GPS within the check-in radius).
  checkedInAt      DateTime?
  checkInDistanceM Int?
  /// Gig pay for this inspection (USD minor units, snapshot when assigned).
  payUsdMinor      Int?
  /// Owed to the inspector once the report is filed; paid in a weekly payout.
  earnedAt         DateTime?
  paidAt           DateTime?
  payoutReference  String?
  /// Staff rating of the inspector's work, 1–5.
  rating           Int?
  /// Picked for a random re-inspection by an in-house lead.
  auditRequested   Boolean          @default(false)
  /// Pieces in the lot; the AQL sample size follows from it.
  lotSize          Int?
  /// General inspection level, e.g. "II"
  aqlLevel         String?
  /// Acceptable quality limits, e.g. "2.5"
  aqlMajor         String?
  aqlMinor         String?
  sampleSize       Int?
  criticalDefects  Int?
  majorDefects     Int?
  minorDefects     Int?
  result           InspectionResult @default(PENDING)
  summary          String?
  reportFileId     String?          @unique @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  order      Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportFile FileAsset?        @relation(fields: [reportFileId], references: [id], onDelete: SetNull)
  bookedBy   User?             @relation("InspectionBookedBy", fields: [bookedById], references: [id], onDelete: SetNull)
  inspector  User?             @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  photos     InspectionPhoto[]

  @@index([inspectorId, result])
  @@index([orderId, type])
  @@index([result, scheduledAt])
  @@map("inspections")
}

/// Inspector's photos: shown to the buyer once sanitized and approved (factory signage, labels).
model InspectionPhoto {
  id           String            @id @default(uuid(7)) @db.Uuid
  inspectionId String            @db.Uuid
  fileId       String            @unique @db.Uuid
  caption      String?
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  file       FileAsset  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trust and operations
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id                    String          @id @default(uuid(7)) @db.Uuid
  orderId               String          @db.Uuid
  authorCompanyId       String          @db.Uuid
  /// The company being reviewed (the factory's company, or the buyer).
  subjectCompanyId      String          @db.Uuid
  direction             ReviewDirection
  /// The order's factory (both directions), for the factory's profile and score.
  manufacturerProfileId String          @db.Uuid
  /// 1–5
  rating                Int
  qualityRating         Int?
  communicationRating   Int?
  deliveryRating        Int?
  comment               String?
  commentFiltered       String?
  status                ReviewStatus    @default(PENDING_MODERATION)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorCompany       Company             @relation(fields: [authorCompanyId], references: [id], onDelete: Cascade)
  subjectCompany      Company             @relation("ReviewSubject", fields: [subjectCompanyId], references: [id], onDelete: Cascade)
  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)

  @@unique([orderId, authorCompanyId])
  @@index([manufacturerProfileId, status])
  @@index([subjectCompanyId, direction])
  @@map("reviews")
}

model Dispute {
  id                  String        @id @default(uuid(7)) @db.Uuid
  orderId             String        @db.Uuid
  openedById          String        @db.Uuid
  assignedToId        String?       @db.Uuid
  reason              DisputeReason
  description         String
  descriptionFiltered String
  status              DisputeStatus @default(OPEN)
  resolution          String?
  refundAmountMinor   BigInt?
  resolvedAt          DateTime?
  resolvedById        String?       @db.Uuid
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  openedBy       User              @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  assignedTo     User?             @relation("DisputeAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy     User?             @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  evidence       DisputeEvidence[]
  /// Mediation threads: one with the buyer, one with the factory.
  threads        Conversation[]
  /// A logistics insurance claim staff opened for this dispute.
  logisticsClaim LogisticsClaim?

  @@index([orderId])
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@map("disputes")
}

model DisputeEvidence {
  id           String            @id @default(uuid(7)) @db.Uuid
  disputeId    String            @db.Uuid
  fileId       String            @unique @db.Uuid
  note         String?
  submittedBy  DisputeParty
  uploadedById String            @db.Uuid
  /// The other side sees it once sanitized and approved; staff always do.
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  dispute    Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  file       FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("dispute_evidence")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Deep-link data, e.g. { "orderId": "…" }
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  /// The activity feed pages back through a user's notifications by time.
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A user's choice per category; missing rows fall back to DEFAULT_PREFERENCES in shared.
model NotificationPreference {
  userId   String               @db.Uuid
  category NotificationCategory
  inApp    Boolean
  email    Boolean
  /// SMS or WhatsApp (the user's channel), once their mobile number is verified.
  text     Boolean              @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// Append-only record of security- and money-relevant actions.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  /// The audit log viewer reads newest first over a time window.
  @@index([createdAt])
  @@map("audit_logs")
}

/// Every object in S3. Linked to its owner through explicit relations, never ownerType/ownerId.
model FileAsset {
  id               String                 @id @default(uuid(7)) @db.Uuid
  bucket           String
  storageKey       String                 @unique
  /// EXIF-stripped / watermark-free copy safe to show the other side.
  sanitizedKey     String?
  /// May contain names: ADMIN-ONLY.
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String?
  purpose          FilePurpose
  status           FileStatus             @default(PENDING_UPLOAD)
  scanStatus       ScanStatus             @default(PENDING)
  uploadedById     String?                @db.Uuid
  ownerCompanyId   String?                @db.Uuid
  uploadedAt       DateTime?
  /// Set for images: the pipeline strips metadata and writes WebP renditions.
  processingStatus ImageProcessingStatus?
  processingError  String?
  processedAt      DateTime?
  width            Int?
  height           Int?
  createdAt        DateTime               @default(now())

  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  ownerCompany Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: SetNull)

  companyDocument   CompanyDocument?
  certification     Certification?
  productImage      ProductImage?
  factoryPhoto      FactoryPhoto?
  renditions        ImageRendition[]
  rfqAttachment     RfqAttachment?
  messageAttachment MessageAttachment?
  milestonePhoto    MilestonePhoto?
  inspectionReport  Inspection?
  inspectionPhoto   InspectionPhoto?
  hubReceiptPhoto   HubReceiptPhoto?
  shipmentUpload    ShipmentUpload?
  disputeEvidence   DisputeEvidence?

  samplePhoto SamplePhoto?

  paymentProof Payment?

  supplierClaim SupplierClaim?

  @@index([ownerCompanyId, purpose])
  @@index([status, createdAt])
  @@map("file_assets")
}

/// A processed, metadata-free WebP copy of an uploaded image. The only form buyers ever get.
model ImageRendition {
  id         String   @id @default(uuid(7)) @db.Uuid
  fileId     String   @db.Uuid
  width      Int
  height     Int
  storageKey String   @unique
  sizeBytes  Int
  format     String   @default("webp")
  createdAt  DateTime @default(now())

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, width])
  @@map("image_renditions")
}

/// A buyer company's saved list of products and factories. Each company has one default "Favorites".
model Shortlist {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @db.Uuid
  name        String
  isDefault   Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   ShortlistItem[]

  @@unique([companyId, name])
  @@map("shortlists")
}

/// Exactly one of productId / manufacturerProfileId is set (checked in SQL).
model ShortlistItem {
  id                    String   @id @default(uuid(7)) @db.Uuid
  shortlistId           String   @db.Uuid
  productId             String?  @db.Uuid
  manufacturerProfileId String?  @db.Uuid
  note                  String?
  createdAt             DateTime @default(now())

  shortlist           Shortlist            @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  product             Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturerProfile ManufacturerProfile? @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)

  @@unique([shortlistId, productId])
  @@unique([shortlistId, manufacturerProfileId])
  @@index([shortlistId, createdAt])
  @@map("shortlist_items")
}

enum WarningLevel {
  WARNING
  FINAL_WARNING
}

/// Raised automatically when a user keeps trying to share contact details.
model AccountWarning {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  level          WarningLevel
  /// Contact-filter hits in the window that triggered it.
  violations     Int
  /// Set when staff issued it by hand (automatic warnings have none).
  issuedById     String?      @db.Uuid
  note           String?
  createdAt      DateTime     @default(now())
  acknowledgedAt DateTime?

  user     User  @relation("UserWarnings", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy User? @relation("WarningIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("account_warnings")
}

/// Every status change of an order: who, when, from what, and why.
model OrderEvent {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?      @db.Uuid
  note        String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
}

/// Photos a buyer attaches when asking for changes to a sample. Factories see them after review.
model SamplePhoto {
  id           String            @id @default(uuid(7)) @db.Uuid
  sampleId     String            @db.Uuid
  fileId       String            @unique @db.Uuid
  reviewStatus MediaReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())

  sample Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([sampleId])
  @@map("sample_photos")
}

enum ReleaseTrigger {
  PRODUCTION_START
  QC_PASSED
  SHIPPED
  DELIVERED
  COMPLETED
  /// The holdback: due once the claim window after delivery closes with no open dispute.
  CLAIM_WINDOW
}

enum ReleaseStatus {
  /// Waiting for its trigger.
  SCHEDULED
  /// Trigger reached: waiting for an admin to release it.
  DUE
  /// Moved from escrow to the factory's payable (and commission to revenue).
  RELEASED
  /// Paid out to the factory.
  PAID
  CANCELLED
}

/// One tranche of an order's escrow, snapshotted from the release schedule when the order is confirmed.
model OrderRelease {
  id                    String         @id @default(uuid(7)) @db.Uuid
  orderId               String         @db.Uuid
  trigger               ReleaseTrigger
  bps                   Int
  currency              Currency
  buyerMinor            BigInt
  manufacturerMinor     BigInt
  commissionMinor       BigInt
  status                ReleaseStatus  @default(SCHEDULED)
  dueAt                 DateTime?
  releasedAt            DateTime?
  approvedById          String?        @db.Uuid
  paidAt                DateTime?
  /// The order moved to another factory: this release belongs to the old one.
  supersededAt          DateTime?
  /// The factory this tranche is owed to (stays the old one after a replacement).
  manufacturerProfileId String?        @db.Uuid
  createdAt             DateTime       @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("ReleaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  payout     Payment?

  /// One live release per moment (partial unique index in SQL: "supersededAt" IS NULL).
  @@index([orderId, trigger])
  @@index([status])
  @@map("order_releases")
}

/// Current exchange rates (units per USD). Every money movement stores the rate it used.
model ExchangeRate {
  currency    Currency @id
  unitsPerUsd Decimal  @db.Decimal(20, 10)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@map("exchange_rates")
}

/// Platform-wide settings editable by admins (e.g. the default release schedule).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Capacity booking
// ─────────────────────────────────────────────────────────────────────────────

enum ProductionLineStatus {
  ACTIVE
  PAUSED
  RETIRED
}

/// A sewing line a factory offers for capacity booking, measured in SAM minutes.
model ProductionLine {
  id                    String               @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String               @db.Uuid
  /// The factory's own label (e.g. "L-04"); shown to the factory and staff only.
  code                  String
  name                  String
  /// Standard allowed minutes the line produces in one working day.
  dailySamMinutes       Int
  /// ISO weekdays the line runs (1 = Monday … 7 = Sunday).
  workingDays           Int[]
  /// Cost of making, in minor units of `currency` per 100 SAM minutes (650 = 6.50 / 100 min).
  /// The factory's price: buyers only ever see it marked up.
  cmRateMinorPer100Min  Int
  currency              Currency             @default(USD)
  status                ProductionLineStatus @default(ACTIVE)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  manufacturerProfile ManufacturerProfile   @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  categories          Category[]            @relation("ProductionLineCategories")
  slots               CapacitySlot[]
  bookings            CapacityBooking[]
  partnerships        CapacityPartnership[]

  @@unique([manufacturerProfileId, code])
  @@index([manufacturerProfileId, status])
  @@map("production_lines")
}

enum CapacitySlotStatus {
  OPEN
  CLOSED
}

/// A window of a line's time opened for booking. Open slots of one line never overlap (DB
/// exclusion constraint) and booked minutes never exceed the total (DB check).
model CapacitySlot {
  id            String             @id @default(uuid(7)) @db.Uuid
  lineId        String             @db.Uuid
  /// Inclusive dates (UTC).
  startDate     DateTime           @db.Date
  endDate       DateTime           @db.Date
  totalMinutes  Int
  bookedMinutes Int                @default(0)
  status        CapacitySlotStatus @default(OPEN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  line        ProductionLine              @relation(fields: [lineId], references: [id], onDelete: Cascade)
  allocations CapacityBookingAllocation[]

  @@index([lineId, startDate])
  @@index([status, startDate])
  @@map("capacity_slots")
}

enum SupplierClaimRegion {
  EU
  UK
  US
  CANADA
  JAPAN
  AUSTRALIA
  MIDDLE_EAST
  OTHER
}

enum SupplierClaimTier {
  /// Household names (shown as "major … brands").
  MAJOR
  ESTABLISHED
}

enum SupplierClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// "We supply these brands": verified privately by staff. Buyers only see a badge built from
/// region, tier and count ("Supplies to 3 major EU brands"), never the names or evidence.
model SupplierClaim {
  id                    String              @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId String              @db.Uuid
  region                SupplierClaimRegion
  tier                  SupplierClaimTier
  /// STAFF AND THE FACTORY ONLY: identifies the factory's customers.
  brandNames            String[]
  evidenceFileId        String?             @unique @db.Uuid
  note                  String?
  status                SupplierClaimStatus @default(PENDING)
  reviewNote            String?
  reviewedAt            DateTime?
  reviewedById          String?             @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  evidenceFile        FileAsset?          @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)
  reviewedBy          User?               @relation("SupplierClaimReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([manufacturerProfileId, status])
  @@index([status, createdAt])
  @@map("supplier_claims")
}

enum CapacityBookingKind {
  /// Some minutes of one window.
  SLOT
  /// A whole window: every free minute, nobody else can book it.
  LINE
  /// One month of a recurring partnership.
  PARTNERSHIP
}

enum CapacityBookingStatus {
  /// Minutes reserved; waiting for the factory to accept and the deposit to arrive.
  HELD
  CONFIRMED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
  /// The hold ran out before it was confirmed: minutes released, deposit refunded in full.
  EXPIRED
}

enum CapacityBookingActor {
  BUYER
  FACTORY
  STAFF
  SYSTEM
}

enum CapacityConversionMode {
  /// Cut, make, trim at the booked rate × SAM per piece.
  CMT
  /// Through an invite-only RFQ to the booked factory.
  FULL_PACKAGE
}

/// A buyer's reservation of line minutes. Prices are snapshotted when the hold is placed.
model CapacityBooking {
  id                        String                  @id @default(uuid(7)) @db.Uuid
  /// e.g. CB-2026-00012
  code                      String                  @unique
  kind                      CapacityBookingKind
  status                    CapacityBookingStatus   @default(HELD)
  buyerCompanyId            String                  @db.Uuid
  createdById               String                  @db.Uuid
  manufacturerProfileId     String                  @db.Uuid
  lineId                    String                  @db.Uuid
  categoryId                String                  @db.Uuid
  partnershipId             String?                 @db.Uuid
  minutes                   Int
  /// Minutes handed back to the line when the booking became an order (unused).
  returnedMinutes           Int                     @default(0)
  /// SAM per piece × 100 (1250 = 12.50 minutes), when the buyer gave one.
  samPerPieceCenti          Int?
  startDate                 DateTime                @db.Date
  endDate                   DateTime                @db.Date
  currency                  Currency
  /// FACTORY AND STAFF ONLY.
  factoryRateMinorPer100Min Int
  /// BUYER AND STAFF ONLY.
  buyerRateMinorPer100Min   Int
  factoryAmountMinor        BigInt
  buyerAmountMinor          BigInt
  feeBps                    Int
  depositBps                Int
  depositMinor              BigInt
  /// Cancellation tiers and the factory's share of a kept deposit, as agreed at booking time.
  cancellationTiers         Json
  factoryShareBps           Int
  note                      String?
  noteFiltered              String?
  holdExpiresAt             DateTime
  reminderSentAt            DateTime?
  factoryAcceptedAt         DateTime?
  depositPaidAt             DateTime?
  confirmedAt               DateTime?
  cancelledAt               DateTime?
  cancelledBy               CapacityBookingActor?
  cancelReason              String?
  refundMinor               BigInt?
  factoryCompensationMinor  BigInt?
  compensationPaidAt        DateTime?
  conversionMode            CapacityConversionMode?
  convertedAt               DateTime?
  orderId                   String?                 @unique @db.Uuid
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  buyerCompany        Company                     @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  createdBy           User                        @relation("CapacityBookingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  manufacturerProfile ManufacturerProfile         @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)
  line                ProductionLine              @relation(fields: [lineId], references: [id], onDelete: Restrict)
  category            Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  partnership         CapacityPartnership?        @relation(fields: [partnershipId], references: [id], onDelete: Restrict)
  order               Order?                      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rfq                 Rfq?                        @relation("CapacityBookingRfq")
  allocations         CapacityBookingAllocation[]
  payments            Payment[]
  ledgerTransactions  LedgerTransaction[]

  @@index([buyerCompanyId, status])
  @@index([manufacturerProfileId, status])
  @@index([status, holdExpiresAt])
  @@index([partnershipId])
  @@map("capacity_bookings")
}

/// Which windows a booking's minutes come from (a partnership month may span several).
model CapacityBookingAllocation {
  id        String @id @default(uuid(7)) @db.Uuid
  bookingId String @db.Uuid
  slotId    String @db.Uuid
  minutes   Int

  booking CapacityBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot    CapacitySlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([bookingId, slotId])
  @@index([slotId])
  @@map("capacity_booking_allocations")
}

enum CapacityPartnershipStatus {
  REQUESTED
  ACTIVE
  DECLINED
  CANCELLED
  ENDED
}

/// A recurring reservation: the same minutes on one line every month for 6–12 months. Accepting
/// it creates one PARTNERSHIP booking per month, each with its own deposit due before the month.
model CapacityPartnership {
  id                        String                    @id @default(uuid(7)) @db.Uuid
  /// e.g. CP-2026-00003
  code                      String                    @unique
  status                    CapacityPartnershipStatus @default(REQUESTED)
  buyerCompanyId            String                    @db.Uuid
  createdById               String                    @db.Uuid
  manufacturerProfileId     String                    @db.Uuid
  lineId                    String                    @db.Uuid
  categoryId                String                    @db.Uuid
  monthlyMinutes            Int
  months                    Int
  /// First day of the first month.
  startMonth                DateTime                  @db.Date
  samPerPieceCenti          Int?
  currency                  Currency
  factoryRateMinorPer100Min Int
  buyerRateMinorPer100Min   Int
  note                      String?
  noteFiltered              String?
  declineReason             String?
  acceptedAt                DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  buyerCompany        Company             @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  createdBy           User                @relation("CapacityPartnershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  manufacturerProfile ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)
  line                ProductionLine      @relation(fields: [lineId], references: [id], onDelete: Restrict)
  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings            CapacityBooking[]

  @@index([buyerCompanyId, status])
  @@index([manufacturerProfileId, status])
  @@map("capacity_partnerships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Logistics (GarmentGate is the shipper: partners only ever see GarmentGate as the customer)
// ─────────────────────────────────────────────────────────────────────────────

enum LogisticsMode {
  SAMPLE_COURIER
  DOMESTIC
  SEA_FCL
  SEA_LCL
  AIR
  /// Door to door, duties paid by GarmentGate and recharged.
  DDP
  /// FCA at a GarmentGate hub: the buyer's own forwarder collects there. No freight charge.
  HANDOVER
}

enum LogisticsPartnerKind {
  FORWARDER
  COURIER
  TRUCKING
  CUSTOMS_BROKER
}

enum RateUnit {
  /// Chargeable weight: the greater of actual and volumetric weight.
  PER_KG
  /// Weight or measure: the greater of CBM and metric tonnes.
  PER_CBM
  PER_CONTAINER
  FLAT
}

enum ContainerType {
  GP20
  GP40
  HC40
}

enum HubOperator {
  GARMENT_GATE
  PARTNER
}

/// A forwarder, courier, trucker or customs broker GarmentGate contracts with.
model LogisticsPartner {
  id           String               @id @default(uuid(7)) @db.Uuid
  /// e.g. LP-0007
  code         String               @unique
  name         String
  kind         LogisticsPartnerKind
  /// ISO 3166-1 alpha-2
  country      String               @db.Char(2)
  contactEmail String?
  contactPhone String?
  notes        String?
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  rateCards      RateCard[]
  hubs           Hub[]
  pickups        PickupRequest[]
  legs           ShipmentLeg[]
  users          User[]
  ledgerAccounts LedgerAccount[]

  @@index([kind, active])
  @@map("logistics_partners")
}

/// A warehouse where factories deliver and GarmentGate receives, checks, repacks and ships.
model Hub {
  id           String      @id @default(uuid(7)) @db.Uuid
  /// e.g. HUB-BD-01
  code         String      @unique
  name         String
  operator     HubOperator @default(GARMENT_GATE)
  partnerId    String?     @db.Uuid
  country      String      @db.Char(2)
  city         String
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  /// UN/LOCODE of the nearest port or airport (e.g. BDCGP).
  port         String?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  partner   LogisticsPartner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  pickups   PickupRequest[]
  receipts  HubReceipt[]
  shipments LogisticsShipment[]

  @@index([country, active])
  @@map("hubs")
}

/// What a partner charges GarmentGate on a route, per unit, for a period. STAFF ONLY.
model RateCard {
  id                 String         @id @default(uuid(7)) @db.Uuid
  partnerId          String         @db.Uuid
  mode               LogisticsMode
  originCountry      String         @db.Char(2)
  /// UN/LOCODE; null = any port in the country.
  originPort         String?
  destinationCountry String         @db.Char(2)
  destinationPort    String?
  unit               RateUnit
  containerType      ContainerType?
  /// Minor units of `currency` per unit.
  costMinor          Int
  minChargeMinor     Int            @default(0)
  currency           Currency       @default(USD)
  transitDaysMin     Int
  transitDaysMax     Int
  validFrom          DateTime       @db.Date
  validTo            DateTime       @db.Date
  active             Boolean        @default(true)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  partner LogisticsPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@index([mode, originCountry, destinationCountry, active])
  @@index([partnerId])
  @@map("rate_cards")
}

/// GarmentGate's markup on freight, by mode and route. The most specific active rule wins.
model LogisticsMarginRule {
  id                 String         @id @default(uuid(7)) @db.Uuid
  name               String
  /// null = every mode / country.
  mode               LogisticsMode?
  originCountry      String?        @db.Char(2)
  destinationCountry String?        @db.Char(2)
  markupBps          Int
  /// At least this much margin per shipment, in minor units of the shipment's currency.
  minMarginMinor     Int            @default(0)
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("logistics_margin_rules")
}

/// Import duty by HS code prefix and destination country, for landed-cost ESTIMATES only.
model DutyRate {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// 2–10 digits; the longest matching prefix wins.
  hsPrefix           String
  destinationCountry String   @db.Char(2)
  rateBps            Int
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([hsPrefix, destinationCountry])
  @@map("duty_rates")
}

enum LogisticsQuoteStatus {
  OFFERED
  ACCEPTED
  /// Replaced by a newer quote or choice before it was paid.
  SUPERSEDED
}

/**
 * A shipping price offered to the buyer for one order, locked when offered. Partner cost and
 * margin are STAFF ONLY; the buyer sees freight, insurance, duty estimate and total.
 */
model LogisticsQuote {
  id                 String               @id @default(uuid(7)) @db.Uuid
  orderId            String               @db.Uuid
  status             LogisticsQuoteStatus @default(OFFERED)
  mode               LogisticsMode
  incoterm           Incoterm
  originCountry      String               @db.Char(2)
  destinationCountry String               @db.Char(2)
  destinationPort    String?
  insured            Boolean
  /// The cargo the price is based on (estimated from the quantity until the factory packs).
  weightGrams        Int
  volumeLitres       Int
  cargoEstimated     Boolean
  provider           String
  rateCardId         String?              @db.Uuid
  partnerId          String?              @db.Uuid
  marginRuleName     String?
  currency           Currency
  partnerCostMinor   BigInt
  freightMinor       BigInt
  insuranceMinor     BigInt
  /// DDP only: GarmentGate pays import duty and recharges this estimate.
  dutyEstimateMinor  BigInt               @default(0)
  totalMinor         BigInt
  transitDaysMin     Int
  transitDaysMax     Int
  validUntil         DateTime
  acceptedAt         DateTime?
  createdAt          DateTime             @default(now())

  consolidationId String? @db.Uuid

  /// HANDOVER only: the buyer's forwarder. Staff use it to arrange the collection; never sent
  /// to the factory or partners.
  forwarderName      String?
  forwarderContact   String?
  forwarderReference String?

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  consolidation Consolidation? @relation(fields: [consolidationId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@map("logistics_quotes")
}

enum PickupStatus {
  REQUESTED
  SCHEDULED
  COLLECTED
  RECEIVED
  CANCELLED
}

enum HubReceiptCondition {
  GOOD
  DAMAGED
  SHORT
  OVER
}

enum LogisticsShipmentStatus {
  PLANNED
  BOOKED
  IN_TRANSIT
  AT_DESTINATION
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

enum ShipmentLegKind {
  FACTORY_TO_HUB
  HUB_TO_PORT
  PORT_TO_PORT
  PORT_TO_BUYER
  /// GarmentGate hands the cargo to the buyer's forwarder at the hub.
  HUB_HANDOVER
}

enum ShipmentLegStatus {
  PENDING
  BOOKED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum LogisticsDocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  /// SWITCH_BL mode: the first B/L names the factory as shipper and stays with staff.
  ORIGINAL_BILL_OF_LADING
  CERTIFICATE_OF_ORIGIN
  INSURANCE_CERTIFICATE
  SHIPPING_LABEL
  CARTON_MARKING
}

enum ShipmentEventSource {
  STAFF
  PARTNER
  FACTORY
  SYSTEM
}

/// What the factory packed: the real cargo, replacing the estimate from the quantity.
model OrderPacking {
  id               String   @id @default(uuid(7)) @db.Uuid
  orderId          String   @unique @db.Uuid
  cartons          Int
  piecesPerCarton  Int?
  grossWeightGrams Int
  netWeightGrams   Int?
  volumeLitres     Int
  /// Carton outer dimensions, when all cartons are the same.
  cartonLengthCm   Int?
  cartonWidthCm    Int?
  cartonHeightCm   Int?
  updatedById      String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_packings")
}

/// The factory asks GarmentGate to collect the goods and take them to a hub (never anywhere else).
model PickupRequest {
  id           String       @id @default(uuid(7)) @db.Uuid
  orderId      String       @db.Uuid
  hubId        String       @db.Uuid
  pickupDate   DateTime     @db.Date
  status       PickupStatus @default(REQUESTED)
  /// Trucker GarmentGate assigned (staff only).
  partnerId    String?      @db.Uuid
  note         String?
  noteFiltered String?
  scheduledAt  DateTime?
  collectedAt  DateTime?
  createdById  String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hub      Hub               @relation(fields: [hubId], references: [id], onDelete: Restrict)
  partner  LogisticsPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  receipts HubReceipt[]

  @@index([orderId, status])
  @@index([hubId, status, pickupDate])
  @@map("pickup_requests")
}

/// What arrived at a hub: counted, checked, possibly repacked and relabelled.
model HubReceipt {
  id               String              @id @default(uuid(7)) @db.Uuid
  hubId            String              @db.Uuid
  orderId          String              @db.Uuid
  pickupId         String?             @db.Uuid
  receivedById     String              @db.Uuid
  receivedAt       DateTime            @default(now())
  cartonsExpected  Int
  cartonsReceived  Int
  grossWeightGrams Int?
  condition        HubReceiptCondition
  repacked         Boolean             @default(false)
  relabelled       Boolean             @default(false)
  notes            String?

  hub    Hub               @relation(fields: [hubId], references: [id], onDelete: Restrict)
  order  Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pickup PickupRequest?    @relation(fields: [pickupId], references: [id], onDelete: SetNull)
  photos HubReceiptPhoto[]

  @@index([orderId])
  @@index([hubId, receivedAt])
  @@map("hub_receipts")
}

model HubReceiptPhoto {
  id        String   @id @default(uuid(7)) @db.Uuid
  receiptId String   @db.Uuid
  fileId    String   @unique @db.Uuid
  createdAt DateTime @default(now())

  receipt HubReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  file    FileAsset  @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@map("hub_receipt_photos")
}

/// One buyer's orders shipped together: one price for the combined cargo, split by weight.
model Consolidation {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// e.g. CON-2026-00004
  code               String        @unique
  buyerCompanyId     String        @db.Uuid
  mode               LogisticsMode
  destinationCountry String        @db.Char(2)
  currency           Currency
  /// What the orders would have cost shipped one by one, and together.
  separateTotalMinor BigInt
  combinedTotalMinor BigInt
  createdAt          DateTime      @default(now())

  buyerCompany Company             @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  quotes       LogisticsQuote[]
  shipments    LogisticsShipment[]

  @@index([buyerCompanyId])
  @@map("consolidations")
}

/// A movement GarmentGate runs, carrying one or more orders of one buyer, in legs.
model LogisticsShipment {
  id                 String                  @id @default(uuid(7)) @db.Uuid
  /// e.g. SHP-2026-00012: the only reference on labels, markings and partner documents.
  code               String                  @unique
  buyerCompanyId     String                  @db.Uuid
  mode               LogisticsMode
  incoterm           Incoterm
  status             LogisticsShipmentStatus @default(PLANNED)
  shipperMode        String
  originHubId        String?                 @db.Uuid
  originCountry      String                  @db.Char(2)
  destinationCountry String                  @db.Char(2)
  destinationPort    String?
  consolidationId    String?                 @db.Uuid
  currency           Currency
  /// What the buyer(s) paid for this movement, and what partners are expected to cost.
  buyerPriceMinor    BigInt
  partnerCostMinor   BigInt
  insuranceMinor     BigInt                  @default(0)
  cartons            Int
  grossWeightGrams   Int
  volumeLitres       Int
  etd                DateTime?
  eta                DateTime?
  departedAt         DateTime?
  deliveredAt        DateTime?
  /// Converted from a factory-booked shipment (before GarmentGate logistics): read-only history.
  historical         Boolean                 @default(false)
  createdById        String                  @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  buyerCompany  Company                  @relation(fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  originHub     Hub?                     @relation(fields: [originHubId], references: [id], onDelete: SetNull)
  consolidation Consolidation?           @relation(fields: [consolidationId], references: [id], onDelete: SetNull)
  orders        LogisticsShipmentOrder[]
  legs          ShipmentLeg[]
  events        ShipmentEvent[]
  documents     LogisticsDocument[]
  uploads       ShipmentUpload[]
  payments      Payment[]
  claims        LogisticsClaim[]

  @@index([buyerCompanyId, status])
  @@index([status, eta])
  @@map("logistics_shipments")
}

model LogisticsShipmentOrder {
  shipmentId       String  @db.Uuid
  orderId          String  @db.Uuid
  /// False once the order is taken off the shipment (it can then join another).
  active           Boolean @default(true)
  cartons          Int
  grossWeightGrams Int
  volumeLitres     Int
  /// This order's share of the shipment's buyer price and partner cost.
  buyerShareMinor  BigInt
  costShareMinor   BigInt

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([shipmentId, orderId])
  @@index([orderId])
  @@map("logistics_shipment_orders")
}

model ShipmentLeg {
  id              String            @id @default(uuid(7)) @db.Uuid
  shipmentId      String            @db.Uuid
  sequence        Int
  kind            ShipmentLegKind
  status          ShipmentLegStatus @default(PENDING)
  partnerId       String?           @db.Uuid
  /// Neutral labels only: hub codes, port codes, "Destination".
  fromLabel       String
  toLabel         String
  carrier         String?
  trackingNumber  String?
  containerNumber String?
  transportDocNo  String?
  costMinor       BigInt?
  etd             DateTime?
  eta             DateTime?
  departedAt      DateTime?
  arrivedAt       DateTime?
  /// The partner accepted the booking.
  acceptedAt      DateTime?
  /// GarmentGate paid the partner for this leg.
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  partner  LogisticsPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  events   ShipmentEvent[]
  uploads  ShipmentUpload[]
  claims   LogisticsClaim[]

  @@unique([shipmentId, sequence])
  @@index([partnerId, status])
  @@index([trackingNumber])
  @@map("shipment_legs")
}

/// The tracking timeline. `publicNote` is filtered and scrubbed; `internalNote` is staff only.
model ShipmentEvent {
  id           String                   @id @default(uuid(7)) @db.Uuid
  shipmentId   String                   @db.Uuid
  legId        String?                  @db.Uuid
  status       LogisticsShipmentStatus?
  source       ShipmentEventSource
  location     String?
  publicNote   String?
  internalNote String?
  occurredAt   DateTime
  createdById  String?                  @db.Uuid
  createdAt    DateTime                 @default(now())

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg      ShipmentLeg?      @relation(fields: [legId], references: [id], onDelete: SetNull)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

/// Documents GarmentGate issued for a shipment (rendered on request; the number is kept).
model LogisticsDocument {
  id         String                @id @default(uuid(7)) @db.Uuid
  shipmentId String                @db.Uuid
  type       LogisticsDocumentType
  /// e.g. SHP-2026-00012-CI
  number     String                @unique
  issuedById String?               @db.Uuid
  createdAt  DateTime              @default(now())

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("logistics_documents")
}

enum ShipmentUploadKind {
  BILL_OF_LADING
  AIRWAY_BILL
  PROOF_OF_DELIVERY
  PHOTO
  OTHER
}

/// Papers and photos a partner (or staff) uploads for a shipment. STAFF ONLY until reviewed.
model ShipmentUpload {
  id            String             @id @default(uuid(7)) @db.Uuid
  shipmentId    String             @db.Uuid
  legId         String?            @db.Uuid
  fileId        String             @unique @db.Uuid
  kind          ShipmentUploadKind
  uploadedById  String             @db.Uuid
  /// Staff published the sanitized copy (or photo renditions) to the buyer.
  buyerVisible  Boolean            @default(false)
  publishedAt   DateTime?
  publishedById String?            @db.Uuid
  createdAt     DateTime           @default(now())

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  leg      ShipmentLeg?      @relation(fields: [legId], references: [id], onDelete: SetNull)
  file     FileAsset         @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_uploads")
}

enum LogisticsClaimType {
  LOSS
  DAMAGE
  SHORTAGE
  DELAY
}

enum LogisticsClaimStatus {
  OPEN
  SUBMITTED
  SETTLED
  REJECTED
}

/**
 * Something went wrong with an order in GarmentGate's care. Staff open it (often from the
 * buyer's dispute), submit it to the cargo insurer, then settle: compensation to the buyer,
 * recovery from the insurer (capped at the insured value), chargeback to the liable partner.
 */
model LogisticsClaim {
  id                     String               @id @default(uuid(7)) @db.Uuid
  /// e.g. CLM-2026-00004
  code                   String               @unique
  shipmentId             String               @db.Uuid
  orderId                String               @db.Uuid
  disputeId              String?              @unique @db.Uuid
  /// The leg the loss happened on (its partner can be charged back).
  legId                  String?              @db.Uuid
  type                   LogisticsClaimType
  status                 LogisticsClaimStatus @default(OPEN)
  /// Staff only.
  description            String
  /// What the buyer reads: filtered and scrubbed.
  publicNote             String?
  currency               Currency
  claimedMinor           BigInt
  /// 110% of CIF when the order was insured, else 0 (snapshot when opened).
  insuredValueMinor      BigInt
  insurerReference       String?
  compensationMinor      BigInt               @default(0)
  insurerRecoveryMinor   BigInt               @default(0)
  partnerChargebackMinor BigInt               @default(0)
  resolution             String?
  createdById            String               @db.Uuid
  settledById            String?              @db.Uuid
  settledAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  shipment LogisticsShipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  dispute  Dispute?          @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  leg      ShipmentLeg?      @relation(fields: [legId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([shipmentId])
  @@index([status, createdAt])
  @@map("logistics_claims")
}

enum OrderChargeKind {
  SAMPLE_FEE
  INSPECTION_FEE
}

/**
 * A service fee the buyer owes on an order, at the price in force when it arose: one per
 * sample requested, one per inspection day (the buyer's first inspection is free: waived).
 * Paid as SAMPLE_FEE / INSPECTION_FEE payments, which become GarmentGate revenue.
 */
model OrderCharge {
  id           String          @id @default(uuid(7)) @db.Uuid
  orderId      String          @db.Uuid
  kind         OrderChargeKind
  amountMinor  BigInt
  currency     Currency
  waived       Boolean         @default(false)
  sampleId     String?         @unique @db.Uuid
  inspectionId String?         @unique @db.Uuid
  createdAt    DateTime        @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, kind])
  @@map("order_charges")
}

/**
 * Staff moved an order to another factory (business model: exception flow, "factory
 * replacement"). The old factory keeps what was already released to it; GarmentGate funds that
 * amount back into escrow so the new factory's releases add up.
 */
model OrderFactoryChange {
  id                 String   @id @default(uuid(7)) @db.Uuid
  orderId            String   @db.Uuid
  fromProfileId      String   @db.Uuid
  toProfileId        String   @db.Uuid
  fromUnitPriceMinor Int
  toUnitPriceMinor   Int
  /// Released to the old factory before the change (buyer-side tranches), funded by GarmentGate.
  fundedMinor        BigInt
  reason             String
  createdById        String   @db.Uuid
  createdAt          DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_factory_changes")
}

enum BankAccountStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  /// The factory submitted newer details.
  REPLACED
}

/**
 * Where GarmentGate pays a factory (bank transfer, SWIFT). Staff only beside the factory itself
 * (which sees it masked); a new submission replaces the previous one and must be verified by
 * staff again before any payout (bank-detail changes are a classic fraud route).
 */
model FactoryBankAccount {
  id            String            @id @default(uuid(7)) @db.Uuid
  companyId     String            @db.Uuid
  holderName    String
  bankName      String
  bankCountry   String            @db.Char(2)
  /// Account number or IBAN, as given.
  accountNumber String
  swiftBic      String?
  /// Local routing: routing number, sort code, IFSC, branch code.
  routingCode   String?
  branch        String?
  currency      Currency
  status        BankAccountStatus @default(PENDING_REVIEW)
  reviewNote    String?
  submittedById String            @db.Uuid
  reviewedById  String?           @db.Uuid
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@index([companyId, status])
  @@index([status, createdAt])
  @@map("factory_bank_accounts")
}

enum SupplyContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

/**
 * A frame agreement (business model: corporate and institutional buyers, yearly uniform
 * contracts): one product from one factory at fixed prices for a period and a volume. The buyer
 * places call-offs against it; each becomes an order at the contract's prices, deposit due.
 */
model SupplyContract {
  id                         String               @id @default(uuid(7)) @db.Uuid
  /// e.g. CTR-2026-00004
  code                       String               @unique
  buyerCompanyId             String               @db.Uuid
  manufacturerProfileId      String               @db.Uuid
  title                      String
  specification              String
  currency                   Currency
  buyerUnitPriceMinor        Int
  manufacturerUnitPriceMinor Int
  contractedQuantity         Int
  calledOffQuantity          Int                  @default(0)
  minCallOffQuantity         Int                  @default(1)
  depositBps                 Int                  @default(3000)
  incoterm                   Incoterm
  destinationCountry         String               @db.Char(2)
  /// Days from a call-off to the requested ship date.
  leadTimeDays               Int
  startsOn                   DateTime             @db.Date
  endsOn                     DateTime             @db.Date
  status                     SupplyContractStatus @default(ACTIVE)
  createdById                String               @db.Uuid
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  orders Order[]

  @@index([buyerCompanyId, status])
  @@index([manufacturerProfileId, status])
  @@map("supply_contracts")
}

enum InspectorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/**
 * Someone applying to inspect for GarmentGate (business model: gig QC inspectors).
 */
model InspectorApplication {
  id              String                     @id @default(uuid(7)) @db.Uuid
  firstName       String
  lastName        String
  email           String
  phone           String
  country         String                     @db.Char(2)
  city            String
  experienceYears Int
  inspectionTypes InspectionType[]
  about           String
  status          InspectorApplicationStatus @default(PENDING)
  reviewNote      String?
  reviewedById    String?                    @db.Uuid
  reviewedAt      DateTime?
  userId          String?                    @unique @db.Uuid
  createdAt       DateTime                   @default(now())

  @@index([status, createdAt])
  @@map("inspector_applications")
}

enum InspectorStatus {
  ACTIVE
  SUSPENDED
}

/**
 * A gig inspector: where they work, what they inspect, how they're rated and paid.
 */
model InspectorProfile {
  userId           String           @id @db.Uuid
  status           InspectorStatus  @default(ACTIVE)
  country          String           @db.Char(2)
  city             String
  latitude         Decimal?         @db.Decimal(9, 6)
  longitude        Decimal?         @db.Decimal(9, 6)
  serviceRadiusKm  Int              @default(50)
  inspectionTypes  InspectionType[]
  /// Overrides the platform day rate (USD minor units).
  dayRateUsdMinor  Int?
  /// Passed GarmentGate's certification (recorded by staff).
  certifiedAt      DateTime?
  ratingSum        Int              @default(0)
  ratingCount      Int              @default(0)
  /// Where GarmentGate pays them: BANK, BKASH or NAGAD, verified by staff.
  payoutMethod     String?
  payoutName       String?
  payoutAccount    String?
  payoutVerifiedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, country])
  @@map("inspector_profiles")
}

// ── Factory plans ──────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum PlanInterval {
  MONTH
  YEAR
}

enum SubscriptionSource {
  STRIPE
  MANUAL
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionPlan {
  PRO
  PREMIUM
  /// GarmentGate Plus, for buyers.
  PLUS
}

/// A paid plan: a factory's Pro/Premium or a buyer's Plus, as a Stripe subscription or a staff
/// grant. Exactly one owner; one live (ACTIVE/PAST_DUE) per owner (partial unique indexes).
model PlanSubscription {
  id                      String             @id @default(uuid(7)) @db.Uuid
  manufacturerProfileId   String?            @db.Uuid
  buyerCompanyId          String?            @db.Uuid
  tier                    SubscriptionPlan
  interval                PlanInterval?
  source                  SubscriptionSource
  status                  SubscriptionStatus @default(INCOMPLETE)
  /// The price at checkout (USD minor units per interval); 0 for a free grant.
  amountUsdMinor          Int                @default(0)
  stripeCustomerId        String?
  stripeSubscriptionId    String?            @unique
  stripeCheckoutSessionId String?            @unique
  /// End of the paid period (a staff grant: its last moment, or null for open-ended).
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean            @default(false)
  note                    String?
  bankReference           String?
  createdById             String?            @db.Uuid
  canceledAt              DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  manufacturerProfile ManufacturerProfile? @relation(fields: [manufacturerProfileId], references: [id], onDelete: Cascade)
  buyerCompany        Company?             @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  invoices            PlanInvoice[]

  @@index([manufacturerProfileId, status])
  @@index([buyerCompanyId, status])
  @@map("plan_subscriptions")
}

/// What was paid for a plan (Stripe invoices, or a staff grant paid by transfer).
model PlanInvoice {
  id              String   @id @default(uuid(7)) @db.Uuid
  subscriptionId  String   @db.Uuid
  stripeInvoiceId String?  @unique
  amountMinor     Int
  currency        Currency
  paidAt          DateTime
  periodEnd       DateTime?
  createdAt       DateTime @default(now())

  subscription PlanSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("plan_invoices")
}

// ── Texts (SMS / WhatsApp) ─────────────────────────────────────────────────

enum TextChannel {
  SMS
  WHATSAPP
}

enum OutboundMessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  /// Not sent (daily cap, channel off, no template, number no longer verified).
  SKIPPED
}

/// Every text GarmentGate sends (or skips), for support, cost and the delivery status.
model OutboundMessage {
  id          String                @id @default(uuid(7)) @db.Uuid
  userId      String?               @db.Uuid
  channel     TextChannel
  to          String
  /// NotificationType, or VERIFY / TEST.
  type        String
  body        String
  status      OutboundMessageStatus @default(QUEUED)
  error       String?
  providerRef String?               @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("outbound_messages")
}

// ── Public website ─────────────────────────────────────────────────────────

enum LeadKind {
  SALES
  ENTERPRISE
  LOGISTICS_PARTNER
  MANUFACTURER
  SUPPORT
  PRESS
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

/// Enquiries from the public website's forms (to GarmentGate only).
model Lead {
  id          String     @id @default(uuid(7)) @db.Uuid
  kind        LeadKind
  status      LeadStatus @default(NEW)
  name        String
  email       String
  company     String?
  country     String?    @db.Char(2)
  phone       String?
  message     String
  source      String?
  handledById String?    @db.Uuid
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("leads")
}

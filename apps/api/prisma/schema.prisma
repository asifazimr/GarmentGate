// GarmentGate data model.
//
// Rules encoded here (see CLAUDE.md):
// - Company holds real identities and is admin-only. Buyers and manufacturers only ever see
//   each other's public codes (BuyerProfile.publicCode / ManufacturerProfile.publicCode).
// - Every price that exists on both sides is stored twice: buyer*Minor (what the buyer pays us)
//   and manufacturer*Minor (what we pay the manufacturer). Margin is derived, never stored.
// - Money is integer minor units + Currency. Unit prices are Int; totals and ledger amounts BigInt.
// - User-generated text keeps the original (admin-only) next to the contact-filtered version.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  MANUFACTURER
  ADMIN
  /// GarmentGate's QC inspectors: staff-side, no company.
  INSPECTOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum CompanyRole {
  OWNER
  MEMBER
}

enum UserTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum CompanyType {
  BUYER
  MANUFACTURER
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

/// Where a company left the onboarding wizard, so it can resume later.
enum OnboardingStep {
  COMPANY_INFO
  PROFILE
  DOCUMENTS
  SUBMITTED
}

enum BuyerBusinessType {
  BRAND
  RETAILER
  IMPORTER
  WHOLESALER
  SOURCING_AGENT
  OTHER
}

enum CompanyDocumentType {
  BUSINESS_LICENSE
  EXPORT_REGISTRATION
  TAX_CERTIFICATE
  BANK_LETTER
  ID_PROOF
  OTHER
}

enum ReviewState {
  PENDING
  VERIFIED
  REJECTED
}

enum CertificationType {
  BSCI_AMFORI
  WRAP
  SEDEX_SMETA
  OEKO_TEX_100
  GOTS
  GRS
  BCI
  ISO_9001
  ISO_14001
  SA8000
  FAIR_TRADE
  HIGG_FEM
  OTHER
}

enum CertificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Currency {
  USD
  EUR
  GBP
  BDT
  INR
  VND
  TRY
  PKR
  CNY
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum RfqStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED

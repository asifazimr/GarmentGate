enum QuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

/// Threads are always between one side and GarmentGate, never buyer↔manufacturer.
enum ConversationType {
  BUYER_PLATFORM
  MANUFACTURER_PLATFORM
  SUPPORT
}

enum ContactFlag {
  EMAIL
  PHONE
  URL
  SOCIAL_HANDLE
  OBFUSCATED_CONTACT
  OTHER
}

enum ModerationStatus {
  CLEAN
  FLAGGED
  REVIEWED_OK
  REVIEWED_BLOCKED
}

enum OrderStatus {
  /// Created when the buyer accepts a quote; terms are confirmed before any deposit.
  DRAFT
  SAMPLING
  SAMPLE_APPROVED
  DEPOSIT_PENDING
  IN_PRODUCTION
  QC
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MilestoneStage {
  ORDER_CONFIRMED
  FABRIC_SOURCING
  CUTTING
  SEWING
  FINISHING
  PACKING
  READY_FOR_INSPECTION
  SHIPPED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum SampleType {
  /// A sample of an existing catalog style, requested from the product page.
  CATALOG
  PROTO
  FIT
  SIZE_SET
  PRE_PRODUCTION
  TOP
  SHIPMENT
}

enum SampleStatus {
  REQUESTED
  IN_PROGRESS
  SHIPPED
  RECEIVED
  APPROVED
  REJECTED
}

enum PaymentDirection {
